{
  // Cloudflare Workers AI Benchmark Platform
  "name": "benchmarks-api",
  "main": "src/api/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["experimental"],
  "worker_loaders": [
    { "binding": "LOADER" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "benchmarks",
      "database_id": "YOUR_D1_ID"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Secrets CF_ACCOUNT_ID and CF_API_TOKEN are set via `wrangler secret put` in CI.
  // For local dev, add them to .dev.vars (already in .gitignore)
}
