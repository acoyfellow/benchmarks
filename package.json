{
  "name": "benchmarks-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "db:schema": "wrangler d1 execute benchmarks --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute benchmarks --file=src/db/seed.sql"
  },
  "dependencies": {
    "@cloudflare/kumo": "latest",
    "@effect/platform": "^0.74.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "effect": "^3.12.0",
    "hono": "^4.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^3.101.0"
  }
}
